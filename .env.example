# =====================================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub ni pegues estas claves en un chat.
# =====================================================================

# Supabase → Project Settings → API Keys
# (En proyectos antiguos aparecen como "anon" y "service_role"; también sirven.)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave secreta: solo la usa el servidor (pedidos, importación, pruebas).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Secreto para los enlaces de seguimiento de pedidos (mínimo 32 caracteres).
# Genéralo en PowerShell con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# No lo cambies después de recibir pedidos: los enlaces anteriores dejarían de funcionar.
ORDER_TOKEN_SECRET=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres

# Solo cuando el permiso de uso de las fotos esté confirmado por escrito:
# FOTOS_AUTORIZADAS=si
